# Copie para um arquivo PRIVADO fora do checkout, modo 0600/ACL restrita.
# docker compose --env-file CAMINHO utiliza estas mesmas variáveis para interpolação.
STAGING_ENV_FILE=/etc/acessoja/staging.env
APP_ENV=staging
DJANGO_SETTINGS_MODULE=acessoja.settings_staging
DEBUG=False
# Gere uma chave aleatoria privada de pelo menos 50 caracteres. Este placeholder falha na validacao.
SECRET_KEY=SUBSTITUIR_CHAVE_PRIVADA
PUBLIC_HOST=staging.seu-dominio.example
ALLOWED_HOSTS=staging.seu-dominio.example,127.0.0.1
FRONTEND_PUBLIC_ORIGIN=https://staging.seu-dominio.example
CORS_ALLOWED_ORIGINS=https://staging.seu-dominio.example
CSRF_TRUSTED_ORIGINS=https://staging.seu-dominio.example
PASSWORD_RESET_CONFIRM_URL='#/recuperar-senha/{uid}/{token}'
PASSWORD_RESET_TIMEOUT=1800
TRUSTED_PROXY_CIDRS=10.85.0.10/32
# Senhas distintas: o app usa papel sem SUPERUSER/CREATEDB/CREATEROLE.
POSTGRES_PASSWORD=SUBSTITUIR_SENHA_ADMINISTRATIVA
APP_DATABASE_PASSWORD=SUBSTITUIR_SENHA_RESTRITA
# Escape caracteres reservados da senha na URL; não copie esta URL para comandos/logs.
DATABASE_URL=postgresql://acessoja_app:SUBSTITUIR_SENHA_RESTRITA@db:5432/acessoja_staging
CACHE_URL=rediscache://cache:6379/1
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.seu-provedor.example
EMAIL_PORT=587
EMAIL_HOST_USER=SUBSTITUIR_USUARIO_SMTP
EMAIL_HOST_PASSWORD=SUBSTITUIR_SEGREDO_SMTP
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=AcessoJa <no-reply@seu-dominio.example>
PRIVACY_CONTACT_EMAIL=privacidade@seu-dominio.example
TLS_CONTACT_EMAIL=operacao@seu-dominio.example
# CIDRs reais e restritos da equipe; o proxy protege também Admin/docs.
PILOT_CIDRS=192.0.2.1/32
DELETION_JOURNAL_DIR=/var/lib/acessoja/deletions
MEDIA_ROOT=/var/lib/acessoja/media
STATIC_ROOT=/app/staticfiles
SECURE_LOG_DIR=/var/log/acessoja
# Destino protegido independente do checkout; configure replicação externa.
BACKUP_ROOT=/srv/acessoja-private-backups
GEO_REQUIRE_SHARED_COORDINATION=True
NOMINATIM_URL=
NOMINATIM_PUBLIC_OPT_IN=False
GEO_LOG_LEVEL=INFO
