# The backup tool uses the PostgreSQL 16 client matching the server.
# Python 3.11 here is a standalone operational tool, not the application runtime.
FROM postgres:16.15-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backend/requirements.txt backend/requirements-geographic.txt /app/backend/
RUN python3 -m venv /opt/backup && /opt/backup/bin/pip install --no-cache-dir -r backend/requirements-geographic.txt
ENV PATH=/opt/backup/bin:$PATH PYTHONDONTWRITEBYTECODE=1
COPY . /app
ENTRYPOINT ["python", "scripts/staging_backup.py"]
