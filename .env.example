# Copie este arquivo para ".env" (na raiz do projeto) e preencha com valores
# locais. NUNCA commite o arquivo ".env" — ele já está no .gitignore.

# Gere uma chave com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=gere-uma-chave-secreta

DEBUG=True

# Lista separada por vírgulas, sem espaços.
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# PostgreSQL local (ajuste usuário/senha/porta conforme seu ambiente):
DATABASE_URL=postgresql://postgres:ALTERE_A_SENHA@localhost:5432/banco_acessoja

# Para rodar sem PostgreSQL local (mesmo formato usado no CI):
# DATABASE_URL=sqlite:///./db_ci.sqlite3
