# Copie este arquivo para ".env" (na raiz do projeto) e preencha com valores
# locais. NUNCA commite o arquivo ".env" — ele já está no .gitignore.

# Gere uma chave com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=gere-uma-chave-secreta

DEBUG=True

# Lista separada por vírgulas, sem espaços.
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# Padrão para desenvolvimento local: SQLite, sem precisar instalar PostgreSQL
# (mesmo formato usado no CI). Funciona direto após `python manage.py migrate`.
DATABASE_URL=sqlite:///./db.sqlite3

# Para usar PostgreSQL local (opcional; ajuste usuário/senha/porta/banco):
# DATABASE_URL=postgresql://postgres:ALTERE_A_SENHA@localhost:5432/banco_acessoja


# Sprint 2: para demonstração acadêmica e buscas limitadas, acionadas pelo usuário.
# Em produção/uso contínuo, configure Overpass próprio ou provedor compatível.
OVERPASS_URL=https://overpass-api.de/api/interpreter
EXTERNAL_PLACES_CACHE_SECONDS=300
GEO_USER_AGENT=AcessoJa/2.0 (https://github.com/acessoja/acessoja-app)

# Geocodificação é opt-in: configure uma instância/provedor adequado ao app.
# Não há autocomplete nem consultas periódicas ao Nominatim.
# Leia README e a política antes de optar por uma instância pública.
NOMINATIM_URL=

# Cache local serve apenas um processo. Para múltiplos workers, use cache compartilhado.
CACHE_URL=locmemcache://acessoja-geographic
# Exemplo de cache compartilhado (instale redis):
# CACHE_URL=rediscache://127.0.0.1:6379/1

# Nominatim público: adesão informada + Redis compartilhado por todos os workers.
# Memcached não implementa o protocolo de leases desta aplicação.
NOMINATIM_PUBLIC_OPT_IN=False

# Modo local: apenas um processo; não habilite Nominatim público com LocMemCache.
# Múltiplos workers: instalar backend/requirements-geographic.txt, configurar
# CACHE_URL=rediscache://127.0.0.1:6379/1 e exigir coordenação compartilhada.
GEO_REQUIRE_SHARED_COORDINATION=False
GEO_CONNECT_TIMEOUT=3
GEO_READ_TIMEOUT=12
GEO_TOTAL_TIMEOUT=18
GEO_OVERPASS_COOLDOWN=15
GEO_NOMINATIM_COOLDOWN=2
GEO_RATE_LIMIT_COOLDOWN=60
EXTERNAL_PLACES_MAX_AGE_SECONDS=900

# Opcional: instância própria/contratada COMPATÍVEL com Nominatim JSONv2.
# URL base (sem /search, /reverse, query ou credenciais). Consulte o fornecedor.
# Chave apenas no servidor, em cabeçalho; nunca colocar no Flutter ou no Git.
NOMINATIM_API_KEY=
NOMINATIM_API_KEY_HEADER=
GEO_LOG_LEVEL=INFO
